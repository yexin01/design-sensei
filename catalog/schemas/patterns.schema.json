{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Sensei pattern catalog (catalog/patterns.yaml)",
  "description": "Searchable implementation patterns and design styles, each traceable to sources and, where possible, concrete files.",
  "type": "object",
  "required": ["schema_version", "patterns"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/definitions/pattern" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*$", "maxLength": 48 },
    "text_list": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 120 } },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "category", "summary", "provenance", "tags", "source_ids",
        "frameworks", "dependencies", "implementation_status", "use_cases",
        "performance", "accessibility", "source_paths"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 3, "maxLength": 100 },
        "category": {
          "enum": [
            "animation", "background-shader", "button", "card-grid", "cursor",
            "data-visualization", "design-style", "design-system", "gradient", "hero",
            "image-to-3d", "interactive-logo", "liquid-glass", "navigation",
            "page-transition", "product-showcase", "responsive-layout", "scroll",
            "three-scene", "typography", "workflow"
          ]
        },
        "summary": { "type": "string", "minLength": 30, "maxLength": 400 },
        "provenance": {
          "description": "upstream = derived from or implemented in the listed sources; original = project-authored guidance; mixed = both.",
          "enum": ["upstream", "original", "mixed"]
        },
        "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/tag" } },
        "source_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "frameworks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/tag" } },
        "dependencies": {
          "description": "npm packages (or other runtime dependencies) the pattern needs; empty when it needs none.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementation_status": {
          "description": "reference_only = pointer to upstream; recipe_available = a project-authored recipe exists; verified_example = a recipe was built and checked in examples/.",
          "enum": ["reference_only", "recipe_available", "verified_example"]
        },
        "use_cases": { "$ref": "#/definitions/text_list" },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_intensity", "fallback_required"],
          "properties": {
            "gpu_intensity": { "enum": ["none", "low", "medium", "high", "unknown"] },
            "fallback_required": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["motion", "reduced_motion_alternative"],
          "properties": {
            "motion": { "enum": ["none", "subtle", "moderate", "intense"] },
            "reduced_motion_alternative": {
              "description": "true when this catalog's guidance for the pattern defines a reduced-motion or static alternative.",
              "type": "boolean"
            },
            "notes": { "type": "string" }
          }
        },
        "source_paths": {
          "description": "Concrete files or directories, written source-id:path/inside/source.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[^\\s:][^\\u0000]*$" }
        },
        "knowledge_doc": { "type": "string", "minLength": 1 },
        "recipe": { "type": "string", "minLength": 1 },
        "related": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "license_status": {
          "description": "Optional. When present it must equal the status derived from the pattern's sources (validated).",
          "enum": ["verified", "custom_terms", "proprietary_terms", "not_found", "pending_verification", "unknown"]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
