#!/usr/bin/env python3
"""Design Sensei command line (plugin bin/ launcher).

When Design Sensei is installed as a Claude Code plugin this file is on the PATH of
the Bash tool, so `design-sensei search "liquid glass"` works from any directory.
"""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "scripts"))

from design_sensei import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
